# Copy to .env (git-ignored) and fill in. Never commit real values.

# live (default): Razorpay API.  sim: synthetic fixtures with a SIMULATED DATA banner.
DATA_MODE=live

# Razorpay TEST-mode keys: Dashboard (Test Mode) -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Set the same secret on the webhook you create in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# Override only to point at a different Razorpay-compatible endpoint
# RAZORPAY_BASE_URL=https://api.razorpay.com
# ALLOW_LIVE_KEYS=false

# Reviewer login + session signing. Generate with: python scripts/hash_password.py
REVIEWER_USER=
REVIEWER_PASSWORD_HASH=
SESSION_SECRET=
# COOKIE_SECURE=true   # set when served over HTTPS

# Optional: enables Gemini for reading evidence text and drafting. Without it live mode uses rules only.
LLM_API_KEY=

# Optional tuning
# DATA_DIR=data
# MAX_UPLOAD_BYTES=4194304
# DISPUTES_CACHE_TTL=30
# PUSH_DRAFT_ON_PROCESS=false   # true = also save a Razorpay draft whenever a case is first analysed
